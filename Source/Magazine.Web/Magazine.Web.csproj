<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <IsPackable>false</IsPackable>
    <SpaRoot>ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>

    <!-- Set this to true if you enable server-side prerendering -->
    <BuildServerSideRenderer>false</BuildServerSideRenderer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish the SPA source files, but do show them in the project files list -->
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App\src\app\accounts\account.ts" />
    <None Remove="App\src\app\articles\article-detail\article-detail.component.ts" />
    <None Remove="App\src\app\articles\article-list\article-list.component.ts" />
    <None Remove="App\src\app\articles\article.service.ts" />
    <None Remove="App\src\app\articles\article.ts" />
    <None Remove="App\src\app\articles\articles-routing.module.ts" />
    <None Remove="App\src\app\articles\articles.module.ts" />
    <None Remove="App\src\app\articles\mock-articles.ts" />
    <None Remove="App\src\app\articles\new-article\new-article.component.ts" />
    <None Remove="App\src\app\comments\comment.ts" />
    <None Remove="App\src\app\config\config.component.ts" />
    <None Remove="App\src\app\config\config.service.ts" />
    <None Remove="App\src\app\config\config.ts" />
    <None Remove="App\src\app\models\IConfig.ts" />
    <None Remove="App\src\environments\environment.dev.ts" />
    <None Remove="ClientApp\src\app\animations.ts" />
    <None Remove="ClientApp\src\app\app-routing.module.ts" />
    <None Remove="ClientApp\src\app\articles\article-detail\article-detail.component.ts" />
    <None Remove="ClientApp\src\app\articles\article-list\article-list.component.ts" />
    <None Remove="ClientApp\src\app\articles\article.service.ts" />
    <None Remove="ClientApp\src\app\articles\article.ts" />
    <None Remove="ClientApp\src\app\articles\articles-routing.module.ts" />
    <None Remove="ClientApp\src\app\articles\articles.module.ts" />
    <None Remove="ClientApp\src\app\articles\mock-articles.ts" />
    <None Remove="ClientApp\src\app\articles\new-article\new-article.component.ts" />
    <None Remove="ClientApp\src\app\can-deactivate.guard.ts" />
    <None Remove="ClientApp\src\app\config\config.component.ts" />
    <None Remove="ClientApp\src\app\config\config.service.ts" />
    <None Remove="ClientApp\src\app\config\config.ts" />
    <None Remove="ClientApp\src\app\dialog.service.ts" />
    <None Remove="ClientApp\src\app\message.service.ts" />
    <None Remove="ClientApp\src\app\models\IConfig.ts" />
    <None Remove="ClientApp\src\app\selective-preloading-strategy.service.ts" />
    <None Remove="ClientApp\src\environments\environment.dev.ts" />
  </ItemGroup>

  <ItemGroup>
    <TypeScriptCompile Include="App\src\app\accounts\account.ts" />
    <TypeScriptCompile Include="App\src\app\articles\article-detail\article-detail.component.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\article-list\article-list.component.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\article.service.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\article.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\articles-routing.module.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\articles.module.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\mock-articles.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\articles\new-article\new-article.component.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\comments\comment.ts" />
    <TypeScriptCompile Include="App\src\app\config\config.component.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\config\config.service.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\config\config.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\app\models\IConfig.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="App\src\environments\environment.dev.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="ClientApp\src\app\animations.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\app-routing.module.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\article-detail\article-detail.component.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\new-article\new-article.component.ts">
      <SubType>Code</SubType>
    </TypeScriptCompile>
    <TypeScriptCompile Include="ClientApp\src\app\articles\article-list\article-list.component.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\article.service.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\article.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\articles-routing.module.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\articles.module.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\articles\mock-articles.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\can-deactivate.guard.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\config\config.component.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\config\config.service.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\config\config.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\dialog.service.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\message.service.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\models\IConfig.ts" />
    <TypeScriptCompile Include="ClientApp\src\app\selective-preloading-strategy.service.ts" />
    <TypeScriptCompile Include="ClientApp\src\environments\environment.dev.ts" />
  </ItemGroup>

  <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <!-- As part of publishing, ensure the JS resources are freshly built in production mode -->
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --prod" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build:ssr -- --prod" Condition=" '$(BuildServerSideRenderer)' == 'true' " />

    <!-- Include the newly-built files in the publish output -->
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\**; $(SpaRoot)dist-server\**" />
      <DistFiles Include="$(SpaRoot)node_modules\**" Condition="'$(BuildServerSideRenderer)' == 'true'" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(DistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
