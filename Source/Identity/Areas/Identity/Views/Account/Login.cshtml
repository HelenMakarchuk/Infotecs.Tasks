@using Infotecs.Identity

@model LoginViewModel

<div class="container">
    <ul class="nav nav-tabs">
        <li class="@(!Model.isRegister ? "active" : "")"><a data-toggle="tab" href="#log-in">Log In</a></li>
        <li class="@(Model.isRegister ? "active" : "")"><a data-toggle="tab" href="#sign-up">Sign Up</a></li>
    </ul>

    <div class="error-details">
        <partial name="_ValidationSummary" />
    </div>

    <div class="tab-content">
        <div id="log-in" class="tab-pane fade @(!Model.isRegister ? "in active" : "")">
            <div class="btn-group-vertical btn-group-identity-provider">
                @foreach (var provider in Model.ExternalProviders)
                {
                    <button type="button"
                            class="btn btn-default"
                            asp-controller="External"
                            asp-action="Challenge"
                            asp-route-provider="@provider.AuthenticationScheme"
                            asp-route-returnUrl="@Model.ReturnUrl">
                        Log in with @provider.DisplayName
                    </button>
                }
            </div>

            <span class="text-divider">OR</span>

            <form asp-action="Login" asp-controller="Account" method="post">

                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="isRegister" />

                <fieldset>
                    <div class="form-group">
                        <label asp-for="Username"></label>
                        <input class="form-control" placeholder="Username or email as on github" asp-for="Username" autofocus>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input type="password" class="form-control" placeholder="Password" asp-for="Password" autocomplete="off">
                    </div>

                    <div class="form-group">
                        <button class="btn btn-primary btn-submit" name="button">Log In</button>
                    </div>
                </fieldset>
            </form>
        </div>

        <div id="sign-up" class="tab-pane fade @(Model.isRegister ? "in active" : "")">
            <div class="btn-group-vertical btn-group-identity-provider">
                @foreach (var provider in Model.ExternalProviders)
                {
                    <button type="button"
                            class="btn btn-default"
                            asp-controller="External"
                            asp-action="Challenge"
                            asp-route-provider="@provider.AuthenticationScheme"
                            asp-route-returnUrl="@Model.ReturnUrl">
                        Sign up with @provider.DisplayName
                    </button>
                }
            </div>

            <span class="text-divider">OR</span>

            <form asp-action="Register" asp-controller="Account" method="post">

                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="isRegister" />

                <fieldset>
                    <div class="form-group">
                        <label asp-for="Username"></label>
                        <input class="form-control" placeholder="Username or email as on github" asp-for="Username" autofocus>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input type="password" class="form-control" placeholder="Password" asp-for="Password" autocomplete="off">
                    </div>

                    <div class="form-group">
                        <button class="btn btn-primary btn-submit" name="button">Sign Up</button>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>
