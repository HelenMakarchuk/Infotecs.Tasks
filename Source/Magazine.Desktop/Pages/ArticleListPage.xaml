<Page x:Class="Magazine.Desktop.Pages.ArticleListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazine.Desktop"
      mc:Ignorable="d"
      Title="ArticleListPage">

    <Border Background="#FAFAFA" BorderBrush="LightGray" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="200" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="LightGray" BorderThickness="0, 0, 1, 0" Margin="0" Padding="0">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" MaxWidth="200">
                    <ListBox Name="ArticleListBox" ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}" BorderThickness="0" Margin="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0" TextTrimming="CharacterEllipsis" Padding="0" FontSize="14" Text="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Name="TitleTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}" VerticalAlignment="Center" Margin="5, 10" Grid.Column="0" Grid.Row="1" Text="{Binding SelectedArticle.Title}" />
                <Image Name="TeaserImage" Grid.Column="0" Grid.Row="2" Source="{Binding SelectedArticle.Teaser}" MaxHeight="100" />
                <TextBox Name="BodyTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="5, 20, 5, 20" Grid.Column="0" Grid.Row="3" Text="{Binding SelectedArticle.Body}" />

                <ListBox Grid.Column="0" Grid.Row="4" ItemsSource="{Binding NotifyUserMessages}" Style="{StaticResource BaseListBoxStyle}" ItemContainerStyle="{StaticResource NotifyUserListBoxItemStyle}" />

                <Grid Grid.Column="0" Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Name="CancelNewCommentButton" Command="{Binding CancelAddingCommentCommand}" Grid.Column="1" Visibility="Hidden" HorizontalAlignment="Right" Style="{StaticResource LogInButtonStyle}">Cancel</Button>
                    <Button Name="AddCommentButton" Command="{Binding AddCommentCommand}" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource LogInButtonStyle}">Add comment</Button>
                </Grid>

                <TextBox Name="NewCommentText" Grid.Column="0" Grid.Row="6" Visibility="Hidden" Margin="0" Padding="0" FontSize="10" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200" Grid.Column="0" Grid.Row="7">
                    <ListBox Name="CommentsListBox" ItemsSource="{Binding SelectedArticle.Comments}" BorderThickness="0" Margin="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#5d92b6" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Margin="0" Padding="4, 4, 4, 2" FontSize="10" Text="{Binding User.Login}" Background="#8ec2e8" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                        <TextBlock Margin="0" Padding="4, 2, 4, 4" FontSize="10" Text="{Binding Body}" Foreground="Black" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <ComboBox Background="Blue" BorderThickness="0" Margin="0" Padding="0" Grid.Column="1" Grid.Row="0">
                    <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Button Name="AddArticleButton" Command="{Binding AddArticleCommand}" HorizontalAlignment="Left" BorderThickness="0" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Add New Article</Button>
                    </ComboBoxItem>
                    <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Button Name="DeleteArticleButton" Command="{Binding DeleteArticleCommand}" HorizontalAlignment="Left"  BorderThickness="0" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Delete Article</Button>
                    </ComboBoxItem>
                    <ComboBoxItem BorderThickness="0, 1, 0, 0" BorderBrush="#8e8e8e" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Button Name="LogOutButton" Command="{Binding LogOutCommand}" HorizontalAlignment="Left"  BorderThickness="0"  Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Log Out</Button>
                    </ComboBoxItem>
                </ComboBox>

                <Button Name="EditArticleTitleButton" Command="{Binding EditArticleTitleCommand}" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource EditButtonStyle}" />
                <Button Name="EditArticleTeaserButton" Command="{Binding EditArticleTeaserCommand}" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource EditButtonStyle}" />
                <Button Name="EditArticleBodyButton" Command="{Binding EditArticleBodyCommand}" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" Style="{StaticResource EditButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Page>