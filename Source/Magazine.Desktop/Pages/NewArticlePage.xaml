<Page x:Class="Magazine.Desktop.Pages.NewArticlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazine.Desktop.Pages"
      mc:Ignorable="d" 
      Title="NewArticlePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0, 5">Title</TextBlock>
            <TextBox Grid.Row="1" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Text="{Binding Title}" />

            <Grid Grid.Row="2" Margin="0, 15, 0, 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <Button Name="ChooseTeaserButton" Command="{Binding SetTeaserCommand}" Grid.Column="0" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Center" Style="{StaticResource LogInButtonStyle}">Choose Teaser</Button>
                <Image Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{Binding Teaser}"></Image>
            </Grid>

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0, 5">Body</TextBlock>
            <TextBox Grid.Row="4" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Text="{Binding Body}" />

            <ListBox Grid.Row="5" ItemsSource="{Binding NotifyUserMessages}" Style="{StaticResource BaseListBoxStyle}" ItemContainerStyle="{StaticResource NotifyUserListBoxItemStyle}" />

            <Grid Grid.Row="6" Margin="0, 0, 0, 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Name="CancelButton" Command="{Binding CancelCommand}" Style="{StaticResource LogInButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">Cancel</Button>
                <Button Grid.Column="2" Name="SaveButton" Command="{Binding SaveCommand}" Style="{StaticResource LogInButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">Save</Button>
            </Grid>
        </Grid>

    </Grid>
</Page>
