<Page x:Class="Magazine.Desktop.Pages.LogInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazine.Desktop.Pages"
      mc:Ignorable="d"
      Title="LogInPage">

    <Grid Margin="50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="1" Background="#FFFFFF" Padding="20" BorderBrush="LightGray" BorderThickness="1">
            <StackPanel MinWidth="300" MaxWidth="300">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}">Infotecs Magazine</TextBlock>
                <TextBox Style="{StaticResource LogInTextBoxStyle}" Text="{Binding Login}" />
                <PasswordBox Name="Password" Style="{StaticResource LogInPasswordBoxStyle}" />
                <Button Margin="0, 12, 0, 0" Style="{StaticResource LogInButtonStyle}" Command="{Binding LogInCommand}" CommandParameter="{Binding ElementName=Password}">Log In</Button>
                <ListBox ItemsSource="{Binding NotifyUserMessages}" Style="{StaticResource BaseListBoxStyle}" ItemContainerStyle="{StaticResource NotifyUserListBoxItemStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="2" Padding="10" Margin="0, 20, 0, 0" Background="#FFFFFF" BorderBrush="LightGray" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Don't have an account?" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource BaseTextBlockStyle}" Margin="5, 0, 0, 0">
                    <Hyperlink Command="{Binding SignUpCommand}">Sign up</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
    
</Page>
