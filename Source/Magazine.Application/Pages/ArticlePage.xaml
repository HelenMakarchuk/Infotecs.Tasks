<Page x:Class="Magazine.Application.Pages.ArticlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazine.Application"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArticlePage"
      Loaded="OnLoad">

    <Border Background="#FAFAFA" BorderBrush="LightGray" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Background="#FFFFFF" BorderBrush="LightGray" BorderThickness="0, 0, 1, 0" Margin="0" Padding="0">
                <ListBox ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}" BorderThickness="0" Margin="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0" Padding="0" FontSize="14" Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SelectedArticle.Title}" />
            <Image Grid.Column="1" Grid.Row="2" Source="{Binding SelectedArticle.Teaser}" />
            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding SelectedArticle.Body}" />

            <ComboBox Background="Blue" BorderThickness="0" Margin="0" Padding="0" Grid.Column="2" Grid.Row="0">
                <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Button Name="AddArticleButton" Click="AddArticleButton_Click" HorizontalAlignment="Left" BorderThickness="0, 0, 0, 1" BorderBrush="#8e8e8e" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Add New Article</Button>
                </ComboBoxItem>
                <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Button Name="EditArticleButton" Click="EditArticleButton_Click" HorizontalAlignment="Left" BorderThickness="0" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Edit Article</Button>
                </ComboBoxItem>
                <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Button Name="DeleteArticleButton" Click="DeleteArticleButton_Click" HorizontalAlignment="Left"  BorderThickness="0" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Delete Article</Button>
                </ComboBoxItem>
            </ComboBox>

            <Button Name="EditArticleTitleButton" Click="EditArticleTitleButton_Click" Grid.Column="2" Grid.Row="1" Style="{StaticResource EditButtonStyle}" />
            <Button Name="EditArticleTeaserButton" Click="EditArticleTeaserButton_Click" Grid.Column="2" Grid.Row="2" Style="{StaticResource EditButtonStyle}" />
            <Button Name="EditArticleBodyButton" Click="EditArticleBodyButton_Click" Grid.Column="2" Grid.Row="3" Style="{StaticResource EditButtonStyle}" />
        </Grid>
    </Border>
</Page>