<Page x:Class="Magazine.Application.Pages.ArticleListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazine.Application"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900"
      Title="ArticleListPage"
      Loaded="OnLoad">

    <Border Background="#FAFAFA" BorderBrush="LightGray" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="LightGray" BorderThickness="0, 0, 1, 0" Margin="0" Padding="0">
                <ListBox SelectionChanged="ArticleListBox_SelectionChanged" Name="ArticleListBox" ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}" BorderThickness="0" Margin="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0" Padding="0" FontSize="14" Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.4*" />
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.5*" />
                </Grid.RowDefinitions>

                <TextBox Name="TitleTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}" Margin="5, 5, 5, 20" Grid.Column="0" Grid.Row="1" Text="{Binding SelectedArticle.Title}" />
                <Image Name="TeaserImage" Grid.Column="0" Grid.Row="2" Source="{Binding SelectedArticle.Teaser}" />
                <TextBox Name="BodyTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Margin="5, 20, 5, 20" Grid.Column="0" Grid.Row="3" Text="{Binding SelectedArticle.Body}" />

                <Border Name="MessageBlockBorder" Visibility="Hidden" Margin="0" BorderThickness="0" Padding="0" Grid.Column="0" Grid.Row="4">
                    <TextBlock Height="0" Name="MessageBlock" Foreground="#f44336" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <ListBox Grid.Column="0" Grid.Row="5" ItemsSource="{Binding SelectedArticle.Comments}" BorderThickness="0" Margin="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Margin="0" Padding="0" FontSize="10" Text="{Binding User.Login}" />
                                <TextBlock Margin="0" Padding="0" FontSize="10" Text="{Binding Body}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ComboBox Background="Blue" BorderThickness="0" Margin="0" Padding="0" Grid.Column="1" Grid.Row="0">
                    <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Button Name="AddArticleButton" Click="AddArticleButton_Click" HorizontalAlignment="Left" BorderThickness="0" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Add New Article</Button>
                    </ComboBoxItem>
                    <ComboBoxItem BorderThickness="0" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Button Name="DeleteArticleButton" Click="DeleteArticleButton_Click" HorizontalAlignment="Left"  BorderThickness="0" Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Delete Article</Button>
                    </ComboBoxItem>
                    <ComboBoxItem BorderThickness="0, 1, 0, 0" BorderBrush="#8e8e8e" Margin="0" Padding="0"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Button Name="LogOutButton" Click="LogOutButton_Click" HorizontalAlignment="Left"  BorderThickness="0"  Margin="0" Padding="4" VerticalAlignment="Stretch" Background="Transparent">Log Out</Button>
                    </ComboBoxItem>
                </ComboBox>

                <Button Name="EditArticleTitleButton" Click="EditArticleTitleButton_Click" Grid.Column="1" Grid.Row="1" Style="{StaticResource EditButtonStyle}" />
                <Button Name="EditArticleBodyButton" Click="EditArticleBodyButton_Click" Grid.Column="1" Grid.Row="3" Style="{StaticResource EditButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Page>