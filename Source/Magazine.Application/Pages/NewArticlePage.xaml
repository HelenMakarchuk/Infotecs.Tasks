<Page x:Class="Magazine.Application.Pages.NewArticlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazine.Application.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="NewArticlePage"
      Loaded="OnLoad">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0, 5">Title</TextBlock>
            <TextBox Name="Title" Grid.Row="1" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" />

            <Grid Grid.Row="2" Margin="0, 15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center">Teaser</TextBlock>
                <Button Name="ChooseTeaserButton" Click="ChooseTeaserButton_Click" Grid.Column="1" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Center" Style="{StaticResource LogInButtonStyle}">Choose image</Button>
                <Image Name="TeaserImage" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Source="/Images/Edit.png"></Image>
            </Grid>

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0, 5">Body</TextBlock>
            <TextBox Name="Body" Grid.Row="4" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" />

            <Border Grid.Row="5" Name="MessageBlockBorder" Visibility="Visible" BorderThickness="0" Padding="0" Margin="0, 5">
                <TextBlock Name="MessageBlock" Foreground="#f44336" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Grid Grid.Row="6" Margin="0, 0, 0, 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Name="CancelButton" Click="CancelButton_Click" Style="{StaticResource LogInButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">Cancel</Button>
                <Button Grid.Column="2" Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource LogInButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">Save</Button>
            </Grid>
        </Grid>

    </Grid>
</Page>
